#!/bin/sh
set -eu

source=$0
if command -v readlink >/dev/null 2>&1; then
    source=$(readlink -f "$0")
fi
root=$(CDPATH= cd -- "$(dirname -- "$source")" && pwd)
binary=$root/build/kvision

if [ ! -x "$binary" ]; then
    echo "Building KVision for first run..."
    cmake -S "$root" -B "$root/build" -DCMAKE_BUILD_TYPE=Release
    cmake --build "$root/build" -j"$(nproc)"
fi

verbose=0
for arg in "$@"; do
    if [ "$arg" = "--verbose" ] || [ "$arg" = "-l" ]; then
        verbose=1
    fi
done

if [ "$verbose" -eq 1 ]; then
    exec "$binary" "$@"
fi

# libva prints three routine "info" lines for every video stream that opens. They are only shown
# with --verbose, and a value set by the user is left alone.
export LIBVA_MESSAGING_LEVEL="${LIBVA_MESSAGING_LEVEL:-0}"

# libhpr prints a routine discovery line directly to the console, and Qt warns about a harmless binding loop in the
# width of a wrapped tooltip each time one appears. Both are only shown with --verbose.
exec "$binary" "$@" 2>&1 | grep -v --line-buffered -e 'find .* mac and .* ip' -e 'QML ToolTip: Binding loop detected for property "implicitWidth"'
