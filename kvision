#!/bin/sh
set -eu

source=$0
if command -v readlink >/dev/null 2>&1; then
    source=$(readlink -f "$0")
fi
root=$(CDPATH= cd -- "$(dirname -- "$source")" && pwd)
binary=$root/build/kvision

if [ ! -x "$binary" ]; then
    echo "Building KVision for first run..."
    cmake -S "$root" -B "$root/build" -DCMAKE_BUILD_TYPE=Release
    cmake --build "$root/build" -j"$(nproc)"
fi

verbose=0
for arg in "$@"; do
    if [ "$arg" = "--verbose" ] || [ "$arg" = "-l" ]; then
        verbose=1
    fi
done

if [ "$verbose" -eq 1 ]; then
    exec "$binary" "$@"
fi

# libhpr prints a routine discovery line directly to the console.
exec "$binary" "$@" 2>&1 | grep -v --line-buffered 'find .* mac and .* ip'
